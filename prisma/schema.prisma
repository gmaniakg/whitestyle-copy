generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Consultation {
  id            String   @id @default(cuid())
  name          String
  phone         String
  treatment     String?  @default("일반/종합상담")
  memo          String?
  agreedPrivacy Boolean  // 개인정보 수집·이용 동의(필수) - 기본값 없음
  agreedSensitive Boolean // 민감정보(건강정보) 처리 별도 동의(필수) - 기본값 없음
  agreedMarketing Boolean @default(false) // 마케팅 수신 동의(선택)
  consentAt     DateTime? // 동의 일시
  privacyPolicyVersion String? // 동의 시점 방침 버전
  source        String?  @default("quick_bar")
  ip            String?
  status        String   @default("PENDING") // PENDING, CONTACTED, RESERVED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
  @@index([status])
}
